{
 "doctype": "DocType",
 "name": "Vehicle Immobilisation",
 "module": "Goods Transport",
 "autoname": "format:VIM-{#####}",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "vehicle",
  "company",
  "reason",
  "start_at",
  "transport_trip",
  "severity",
  "responsible",
  "supplier",
  "odometer",
  "description",
  "asset_repair",
  "resolution",
  "released_at",
  "released_by"
 ],
 "fields": [
  {
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "label": "Vehicle",
   "options": "Vehicle",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "reason",
   "fieldtype": "Select",
   "label": "Reason",
   "options": "Breakdown\nMaintenance\nOther",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "start_at",
   "fieldtype": "Datetime",
   "label": "Start",
   "reqd": 1,
   "default": "Now",
   "in_list_view": 1
  },
  {
   "fieldname": "transport_trip",
   "fieldtype": "Link",
   "label": "Transport Trip",
   "options": "Transport Trip"
  },
  {
   "fieldname": "severity",
   "fieldtype": "Select",
   "label": "Severity",
   "options": "Low\nHigh\nCritical",
   "default": "High",
   "reqd": 1
  },
  {
   "fieldname": "responsible",
   "fieldtype": "Link",
   "label": "Responsible",
   "options": "User"
  },
  {
   "fieldname": "supplier",
   "fieldtype": "Link",
   "label": "Garage or Supplier",
   "options": "Supplier"
  },
  {
   "fieldname": "odometer",
   "fieldtype": "Data",
   "label": "Odometer (km)"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description",
   "reqd": 1
  },
  {
   "fieldname": "asset_repair",
   "fieldtype": "Link",
   "label": "Asset Repair",
   "options": "Asset Repair"
  },
  {
   "fieldname": "resolution",
   "fieldtype": "Small Text",
   "label": "Resolution"
  },
  {
   "fieldname": "released_at",
   "fieldtype": "Datetime",
   "label": "Released At",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "released_by",
   "fieldtype": "Link",
   "label": "Released By",
   "options": "User",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "create": 1,
   "read": 1,
   "write": 1,
   "report": 1
  },
  {
   "role": "Stock Manager",
   "create": 1,
   "read": 1,
   "write": 1,
   "report": 1
  },
  {
   "role": "Stock User",
   "create": 1,
   "read": 1,
   "write": 1,
   "report": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
