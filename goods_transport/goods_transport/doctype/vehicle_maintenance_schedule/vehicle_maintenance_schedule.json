   "in_list_view": 1
  },
  {
   "fieldname": "completions",
   "fieldtype": "Table",
   "label": "Completed Work",
   "options": "Vehicle Maintenance Completion",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "create": 1,
   "read": 1,
   "write": 1,
   "report": 1
  },
  {
   "role": "Stock Manager",
   "create": 1,
   "read": 1,
   "write": 1,
   "report": 1
  },
  {
   "role": "Stock User",
   "read": 1,
   "report": 1
  }
 ],
 "sort_field": "modified",
