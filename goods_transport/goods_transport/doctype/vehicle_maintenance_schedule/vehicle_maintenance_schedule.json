{
 "doctype": "DocType",
 "name": "Vehicle Maintenance Schedule",
 "module": "Goods Transport",
 "autoname": "format:VMS-{#####}",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "vehicle",
  "company",
  "operation",
  "enabled",
  "responsible",
  "asset_maintenance",
  "asset_task",
  "initial_date",
  "initial_odometer",
  "interval_days",
  "interval_km",
  "advance_days",
  "advance_km",
  "blocking",
  "due_date",
  "due_odometer",
  "completions"
 ],
