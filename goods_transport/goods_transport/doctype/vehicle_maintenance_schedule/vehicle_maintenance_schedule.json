   "fieldname": "operation",
   "fieldtype": "Data",
   "label": "Operation",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1"
  },
  {
   "fieldname": "responsible",
   "fieldtype": "Link",
   "label": "Responsible",
   "options": "User",
   "reqd": 1
  },
  {
   "fieldname": "asset_maintenance",
   "fieldtype": "Link",
   "label": "Asset Maintenance",
   "options": "Asset Maintenance"
  },
  {
   "fieldname": "asset_task",
