   "label": "Asset Maintenance Task Row"
  },
  {
   "fieldname": "initial_date",
   "fieldtype": "Date",
   "label": "Initial Date"
  },
  {
   "fieldname": "initial_odometer",
   "fieldtype": "Data",
   "label": "Initial Odometer (km)"
  },
  {
   "fieldname": "interval_days",
   "fieldtype": "Int",
   "label": "Interval (days)",
   "non_negative": 1
  },
  {
   "fieldname": "interval_km",
   "fieldtype": "Int",
   "label": "Interval (km)",
   "non_negative": 1
  },
  {
   "fieldname": "advance_days",
   "fieldtype": "Int",
   "label": "Alert Advance (days)",
   "non_negative": 1
  },
  {
   "fieldname": "advance_km",
   "fieldtype": "Int",
   "label": "Alert Advance (km)",
